# Local Supabase (pnpm supabase start). For the hosted project, swap in its URL + publishable key.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Web push. The PUBLIC half of the VAPID keypair, which is safe in the client bundle and is what
# the Turn-on-notifications button subscribes with — without it the button reports "not available".
# The private key is a function secret and must never be prefixed EXPO_PUBLIC_.
# Generate both, once: supabase/functions/notify/README.md § Generate the VAPID keypair.
EXPO_PUBLIC_VAPID_PUBLIC_KEY=
